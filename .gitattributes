# Normalize text to LF in the repository; each checkout converts as it likes.
* text=auto

# Packet captures and recorded traces are compared byte for byte.
*.vmcpackets binary
*.mocopipackets binary
*.vrchatoscpackets binary
*.bvh binary

# USDA fixtures check out with LF everywhere: a CRLF smudge changes the content
# of a multi-line string (usd-vrm-plugins, PR #42).
*.usda text eol=lf

# Recorded capture traces, for the same reason as the captures above: a trace
# is re-emitted through usd-motion-plugins' writer and compared as bytes. The
# rule is declared here so an import that brings traces does not have to
# remember it.
#
# These fixtures must stay `binary` and NOT `text eol=lf`: a later `text` rule
# overrides `binary`, which re-enables CRLF -> LF normalization on `git add`
# and silently strips 0x0D bytes out of a datagram that happens to contain the
# pair 0x0D 0x0A. `binary` already suppresses every smudge and clean filter,
# which is the whole of what a byte-compare corpus needs on a Windows
# checkout.
*.trace binary

# Frame wire messages are compared byte for byte, and some are deliberately
# not UTF-8 (libs/motionConnectorWire/tests/corpus). Their expectations file is
# read by the same suite and by the generator's --check, so it keeps LF.
*.frame.json binary
libs/motionConnectorWire/tests/corpus/expectations.txt text eol=lf

# The WebSocket connector's corpora: byte streams and message captures, in the
# packet-capture format, compared byte for byte by the generator's --check.
# A stream carries CR LF inside its HTTP heads, which `text` would strip.
*.wsstream binary
*.websocketpackets binary
libs/motionConnectorWebSocket/tests/corpus/*/expectations.txt text eol=lf
