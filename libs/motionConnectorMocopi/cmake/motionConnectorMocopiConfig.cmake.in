@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# OpenUSD's pxrConfig.cmake defines imported targets unconditionally, so skip it
# when a consumer has already resolved the Gf target this package needs
# transitively through motionCore.
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
if(NOT TARGET motionConnectorCore::motionConnectorCore)
    find_dependency(motionConnectorCore CONFIG REQUIRED)
endif()
# What was one `motionRuntime` in usd-vrm-plugins is two packages here, and a
# consumer resolves both: the frame assembler reads motionSampling's source
# interface and the live source writes motionRecording's capture trace.
if(NOT TARGET motionSampling::motionSampling)
    find_dependency(motionSampling CONFIG REQUIRED)
endif()
if(NOT TARGET motionRecording::motionRecording)
    find_dependency(motionRecording CONFIG REQUIRED)
endif()
# The live half's shared leaf, which now carries the socket, the capture format
# and the diagnostic vehicle (WORKSPACE.md §2). Its own config brings the
# platform's threading primitive with it — an imported target that is a configure
# error rather than a link one when unresolved — so this file no longer has to
# decide whether to ask for one. It used to say it did not need to, because this
# adapter holds no mutex; that is still true, and it is now that library's
# statement to make instead of this one's.
if(NOT TARGET motionConnectorTransport::motionConnectorTransport)
    find_dependency(motionConnectorTransport CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/motionConnectorMocopiTargets.cmake")
check_required_components(motionConnectorMocopi)
