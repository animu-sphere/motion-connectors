@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/motionConnectorCoreTargets.cmake")
check_required_components(motionConnectorCore)